##
## Reduced trace list for course project (single-core).
## Covers SPEC2006, SPEC2017, ligra, parsec, and cloudsuite
## with ~18 representative traces (vs ~90+ in the full set).
##
## Selection strategy: 1-2 traces per benchmark, covering
## diverse memory access patterns (streaming, random, graph, etc.)
##

# =================== SPEC2006 ===================
# Integer benchmarks (compute & control intensive)
NAME=403.gcc-16B
TRACE=$(PYTHIA_HOME)/traces/403.gcc-16B.champsimtrace.xz
KNOBS=

# Memory-intensive benchmarks
NAME=429.mcf-184B
TRACE=$(PYTHIA_HOME)/traces/429.mcf-184B.champsimtrace.xz
KNOBS=

# Floating-point benchmarks
NAME=433.milc-127B
TRACE=$(PYTHIA_HOME)/traces/433.milc-127B.champsimtrace.xz
KNOBS=

# ILP-heavy benchmarks
NAME=450.soplex-247B
TRACE=$(PYTHIA_HOME)/traces/450.soplex-247B.champsimtrace.xz
KNOBS=

# Quantum simulation (streaming-like)
NAME=462.libquantum-1343B
TRACE=$(PYTHIA_HOME)/traces/462.libquantum-1343B.champsimtrace.xz
KNOBS=

# Streaming FP
NAME=470.lbm-1274B
TRACE=$(PYTHIA_HOME)/traces/470.lbm-1274B.champsimtrace.xz
KNOBS=

# Network simulation (branch-heavy)
NAME=471.omnetpp-188B
TRACE=$(PYTHIA_HOME)/traces/471.omnetpp-188B.champsimtrace.xz
KNOBS=

# Pathfinding (irregular access)
NAME=473.astar-359B
TRACE=$(PYTHIA_HOME)/traces/473.astar-359B.champsimtrace.xz
KNOBS=

# XML processing (large working set)
NAME=483.xalancbmk-127B
TRACE=$(PYTHIA_HOME)/traces/483.xalancbmk-127B.champsimtrace.xz
KNOBS=


