		if(!prefetchers[index]->get_type().compare("tsetlin"))
		{
			TsetlinPrefetcher *pref_tsetlin = (TsetlinPrefetcher*)prefetchers[index];
			pref_tsetlin->update_acc(acc_level);
		}
		if(!prefetchers[index]->get_type().compare("linucb"))
		{
			ContextualBanditPrefetcher *pref_linucb = (ContextualBanditPrefetcher*)prefetchers[index];
			pref_linucb->update_acc(acc_level);
		}
		if(!prefetchers[index]->get_type().compare("meta_selector"))
		{
			MetaSelectorPrefetcher *pref_meta = (MetaSelectorPrefetcher*)prefetchers[index];
